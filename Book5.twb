      <aliases enabled='yes' />
      <column caption='Selected KPI' datatype='real' name='[Calculation_1041815956885504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Sales&quot; THEN SUM([sales_amount])&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([profit])&#13;&#10;WHEN &quot;Quantity&quot; THEN SUM([quantity])&#13;&#10;END' />
      </column>
      <column caption='Profit Margin ' datatype='real' name='[Calculation_1582225905655808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([profit])/sum([sales_amount]) *100' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_1582225907609601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([sales_amount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_1582225908092930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sales_amount] * (1 - [discount_pct] / 100)' />
      </column>
